# Copy to .env.local. These are placeholders, not usable credentials.
# Browser-visible Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key

# Server-side only: never prefix these values with NEXT_PUBLIC_
SUPABASE_SERVICE_KEY=replace-with-your-service-role-key
R2_ACCOUNT_ID=replace-with-your-account-id
R2_ACCESS_KEY_ID=replace-with-your-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
R2_BUCKET_NAME=your-match-video-bucket
MODAL_SUBMIT_URL=https://your-analysis-submit-endpoint.modal.run
OPENAI_API_KEY=
# Optional; leave empty to use the model configured in src/lib/ai/openai.ts
OPENAI_MODEL=
